# ── contoh setelan Van Chat.SPY ────────────────────────────────────────
# Salin jadi .env lalu isi seperlunya:   cp .env.example .env
#
# Penyedia AI aplikasi ini: **NaraRouter** (https://router.bynara.id).
# Hanya butuh SATU kunci — dibuat di dasbor NaraRouter (halaman API keys),
# berawalan `sk-nry-`.

# Nama penyedia (bawaan: bynara)
AI_PROVIDER=bynara

# Alamat API. Boleh dikosongkan — bawaannya sudah https://router.bynara.id/v1.
# Isi hanya kalau kamu memakai gateway OpenAI-compatible lain (router sendiri, dsb).
# Aplikasi akan membaca daftar model dari gateway itu; kosongkan lagi untuk kembali.
AI_BASE_URL=

# Kunci API NaraRouter milikmu (WAJIB untuk percakapan). Jangan ditulis di kode/repo.
AI_API_KEY=

# Opsional: pilih model per mode. Kalau dibiarkan kosong, aplikasi memilih
# otomatis dari daftar model milik akunmu (GET /v1/models).
# Contoh (paket gratis):
# AI_MODEL_FAST=agnes-2.5-flash
# AI_MODEL_THINK=agnes-3-flash
# AI_MODEL_DEEP=deepseek-v4-flash
# AI_MODEL_EXPERT=deepseek-v4-pro
# AI_MODEL_VISI=gemini-3.8-flash-high      ← hanya kalau model itu ada di paketmu

# Opsional: paksa urutan model yang dipakai (dipisah koma)
# AI_MODELS=agnes-3-flash,agnes-2.5-flash

# Opsional: batasi model yang boleh muncul di Setelan
# AI_MODEL_IZIN=agnes-2.5-flash,agnes-3-flash

# Opsional: kalau web dibuka dari domain lain (CORS)
# ALLOWED_ORIGINS=https://chat.contoh.com
# APP_URL=https://chat.contoh.com

# ── Fitur di luar percakapan teks (opsional, punya kunci sendiri) ──────
# Gambar: NaraRouter juga menyediakan gambar di api-images.bynara.id
# IMAGE_PROVIDER=bynara
# IMAGE_API_KEY=sk-nry-…
# IMAGE_MODEL=agnes-image-2.1-flash
#
# Suara (transkripsi/Text-to-Speech) lewat layanan apa pun yang protokolnya
# sama dengan OpenAI — tanpa ini, aplikasi memakai suara bawaan browser:
# STT_PROVIDER=
# STT_API_KEY=
# TTS_PROVIDER=
# TTS_API_KEY=
