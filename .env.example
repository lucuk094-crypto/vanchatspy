# ── contoh setelan untuk docker compose / hosting ─────────────────────
# Salin jadi .env lalu isi seperlunya:  cp .env.example .env

# Penyedia teks yang dipakai web ini
AI_PROVIDER=9router

# Alamat 9Router DILIHAT DARI TEMPAT WEB BERJALAN:
#  - web & 9Router di komputer yang sama  → http://127.0.0.1:20128/v1
#  - web di container, 9Router container  → http://ninerouter:20128/v1
#  - 9Router di PC lain / VPS / lewat tunnel → alamatnya (https://xxxx.trycloudflare.com/v1)
AI_BASE_URL=http://127.0.0.1:20128/v1

# Kunci dari dashboard 9Router (kosongkan kalau 9Router tidak memakai kunci)
AI_API_KEY=

# Opsional: model per mode (kalau dibiarkan kosong, dipilih otomatis dari daftar router)
AI_MODEL_FAST=
AI_MODEL_THINK=
AI_MODEL_DEEP=
AI_MODEL_EXPERT=
AI_MODEL_VISI=

# Opsional: batasi model yang boleh dipakai, atau daftar model cadangan
# AI_MODEL_IZIN=gh/gpt-5-mini,kr/claude-sonnet-4.5
# AI_MODELS=gh/gpt-5-mini,kr/claude-sonnet-4.5

# ── Contoh penyedia yang sudah dikenal namanya ──────────────────────────────
# NaraRouter (https://router.bynara.id): gateway multi-model OpenAI-compatible,
# ada paket gratis (Agnes 2.5 Flash dkk). Butuh kunci berawalan sk-nry-.
#   AI_PROVIDER=bynara
#   AI_BASE_URL=            ← boleh dikosongkan: otomatis https://router.bynara.id/v1
#   AI_API_KEY=sk-nry-…
#
# Gaya protokol penyedia: biarkan kosong = otomatis (nama penyedia mengandung
# anthropic/claude/freemodel → gaya Anthropic, selain itu gaya OpenAI).
# Isi "anthropic" untuk penyedia yang hanya melayani POST /messages
# (mis. cc.freemodel.dev, atau gateway Claude lain).
# AI_GAYA=anthropic

# Paksa pakai router (mis. 9Router) walaupun ada kunci langsung: 1/true/ya/on
# AI_ROUTER=

# Opsional: domain yang boleh memakai API ini (kalau web dibuka dari domain lain)
# ALLOWED_ORIGINS=https://chat.contoh.com
# APP_URL=https://chat.contoh.com

# Fitur di luar teks tetap butuh kuncinya sendiri:
# IMAGE_PROVIDER=openai
# IMAGE_API_KEY=
# STT_PROVIDER=openai
# STT_API_KEY=
# TTS_PROVIDER=openai
# TTS_API_KEY=
