# ── contoh setelan Van Chat.SPY ────────────────────────────────────────
# Salin jadi .env lalu isi seperlunya:   cp .env.example .env
# (Untuk pemakaian lokal, cara paling mudah: isi AI_API_KEY di .env.local —
#  lihat .env.local.contoh. Berkas itu tidak ikut repo/zip.)
#
# Penyedia AI aplikasi ini: **9Router** — satu-satunya penyedia.
# Alamat bawaannya https://rqacwx8.abc-tunnel.us/v1 (tunnel 9Router-mu).
# Hanya butuh SATU kunci.

# Nama penyedia (bawaan: 9router)
AI_PROVIDER=9router

# Alamat 9Router. Boleh dikosongkan — bawaannya sudah alamat tunnel di atas.
# Ganti kalau 9Router dijalankan sendiri, mis.: http://127.0.0.1:20128/v1
AI_BASE_URL=

# Kunci 9Router (WAJIB untuk percakapan). Jangan ditulis di kode/repo.
AI_API_KEY=

# Opsional: pilih model per mode. Kalau kosong, aplikasi memilih sendiri dari
# daftar model 9Router (GET /v1/models). Yang terbukti jalan lewat tunnel ini:
# AI_MODEL_FAST=kr/claude-haiku-4.5
# AI_MODEL_THINK=kr/claude-sonnet-4.5
# AI_MODEL_DEEP=kr/claude-sonnet-4.5
# AI_MODEL_EXPERT=kr/claude-sonnet-4.5-agentic
# AI_MODEL_VISI=kr/claude-sonnet-4.5      ← model untuk kirim foto

# Opsional: paksa urutan model yang dipakai (dipisah koma)
# AI_MODELS=kr/claude-sonnet-4.5,kr/claude-haiku-4.5

# Opsional: batasi model yang boleh muncul di Setelan
# AI_MODEL_IZIN=kr/claude-haiku-4.5,kr/claude-sonnet-4.5

# Opsional: kalau web dibuka dari domain lain (CORS)
# ALLOWED_ORIGINS=https://chat.contoh.com
# APP_URL=https://chat.contoh.com

# ── Fitur di luar percakapan teks (opsional, punya kunci sendiri) ──────
# Pembuat gambar: 9Router lewat tunnel ini TIDAK melayani pembuatan gambar,
# jadi biarkan kosong — panelnya jujur menampilkan "belum aktif".
# IMAGE_PROVIDER=
# IMAGE_BASE_URL=
# IMAGE_API_KEY=
# IMAGE_MODEL=gpt-image-1
#
# Suara (transkripsi/Text-to-Speech) lewat layanan apa pun yang protokolnya
# sama dengan OpenAI — tanpa ini, aplikasi memakai suara bawaan browser:
# STT_PROVIDER=
# STT_API_KEY=
# TTS_PROVIDER=
# TTS_API_KEY=
