# ── contoh setelan Van Chat.SPY ────────────────────────────────────────
# Salin jadi .env lalu isi seperlunya:   cp .env.example .env
# (Untuk pemakaian lokal, cara paling mudah: isi di .env.local — lihat
#  .env.local.contoh. Berkas itu tidak ikut repo/zip.)
#
# Bawaan aplikasi ini: **9Router** (tunnel-mu) untuk percakapan, dan
# **Pollinations** untuk pembuat gambar (gratis, TANPA kunci).
# Mau SEMUA fitur gratis dengan satu akun? Lihat PANDUAN-PENYEDIA-GRATIS.md
# → Cloudflare Workers AI (10.000 neuron/hari, tanpa kartu).

# ── 1. Penyedia percakapan ─────────────────────────────────────────────
# Pilihan: 9router (bawaan) · gemini · pollinations · groq · cloudflare
AI_PROVIDER=9router

# Alamat penyedia. Boleh dikosongkan untuk memakai bawaan penyedia di atas.
#   9router    : https://rqacwx8.abc-tunnel.us/v1
#   gemini     : https://generativelanguage.googleapis.com/v1beta/openai
#   pollinations: https://text.pollinations.ai/openai
#   groq       : https://api.groq.com/openai/v1
#   cloudflare : disusun otomatis dari CF_ACCOUNT_ID
AI_BASE_URL=

# Kunci penyedia. Jangan ditulis di kode/repo.
#   AI_API_KEY    → untuk 9router (atau penyedia apa pun)
#   GEMINI_API_KEY / GOOGLE_API_KEY → untuk AI_PROVIDER=gemini
#   GROQ_API_KEY  → untuk AI_PROVIDER=groq
#   CF_API_TOKEN + CF_ACCOUNT_ID    → untuk AI_PROVIDER=cloudflare
AI_API_KEY=

# Kunci lain (isi sesuai penyedia yang dipakai):
# GEMINI_API_KEY=
# GROQ_API_KEY=
# CF_ACCOUNT_ID=
# CF_API_TOKEN=

# Opsional: pilih model per mode. Kalau kosong, aplikasi memilih sendiri
# dari daftar model penyedia (GET /models). Yang terbukti jalan di 9Router:
# AI_MODEL_FAST=kr/claude-haiku-4.5
# AI_MODEL_THINK=kr/claude-sonnet-4.5
# AI_MODEL_DEEP=kr/claude-sonnet-4.5
# AI_MODEL_EXPERT=kr/claude-sonnet-4.5-agentic
# AI_MODEL_VISI=kr/claude-sonnet-4.5      ← model untuk kirim foto

# Opsional: paksa urutan model yang dipakai (dipisah koma)
# AI_MODELS=kr/claude-sonnet-4.5,kr/claude-haiku-4.5

# Opsional: batasi model yang boleh muncul di Setelan
# AI_MODEL_IZIN=kr/claude-haiku-4.5,kr/claude-sonnet-4.5

# Opsional: kalau web dibuka dari domain lain (CORS)
# ALLOWED_ORIGINS=https://chat.contoh.com
# APP_URL=https://chat.contoh.com

# ── 2. Pembuat gambar ─────────────────────────────────────────────────
# Kosongkan IMAGE_PROVIDER → otomatis GRATIS tanpa kunci:
#   • AI_PROVIDER=cloudflare  → FLUX di akun Cloudflare-mu (tanpa tanda air)
#   • selain itu              → Pollinations (ada tanda air)
# Pilihan lain: cloudflare · gemini · pollinations · off · nama penyedia
# sendiri yang protokolnya OpenAI (/images/generations).
# IMAGE_PROVIDER=
# IMAGE_BASE_URL=
# IMAGE_API_KEY=
# IMAGE_MODEL=sana                       ← model gratis Pollinations yang aktif
# (untuk Cloudflare: IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell)

# ── 3. Suara sisi server (opsional) ────────────────────────────────────
# Tanpa ini aplikasi memakai suara bawaan browser (Web Speech API).
# Dengan Cloudflare: Whisper untuk mendengar, MeloTTS untuk berbicara.
# STT_PROVIDER=cloudflare
# STT_MODEL=@cf/openai/whisper
# TTS_PROVIDER=cloudflare
# TTS_MODEL=@cf/myshell-ai/melotts
# TTS_VOICE=id-ID
# (atau penyedia apa pun yang protokolnya sama dengan OpenAI)
# STT_API_KEY=
# TTS_API_KEY=
