# ── contoh setelan lokal (salin jadi .env.local lalu isi kuncimu) ───────────
# 1) Nyalakan 9Router (tunnel).
# 2) Isi kunci di bawah.
# 3) Jalankan:  node tools/server-uji.mjs   → http://127.0.0.1:8131/
#
# Berkas .env.local TIDAK ikut repo/zip (sudah ada di .gitignore).

AI_API_KEY=sk-isi-kunci-9router-mu

# Alamat akses 9Router. Bawaannya alamat tunnel; ganti kalau 9Router-mu
# dijalankan di komputer sendiri, mis.: http://127.0.0.1:20128/v1
# AI_BASE_URL=https://rqacwx8.abc-tunnel.us/v1

# Pilih model per mode (opsional — kalau kosong, aplikasi memilih sendiri
# dari daftar model 9Router).
# AI_MODEL_FAST=kr/claude-haiku-4.5
# AI_MODEL_THINK=kr/claude-sonnet-4.5
# AI_MODEL_DEEP=kr/claude-sonnet-4.5
# AI_MODEL_EXPERT=kr/claude-sonnet-4.5-agentic
