# ── contoh setelan lokal (salin jadi .env.local lalu isi kuncimu) ───────────
# Penyedia bawaan sekarang: APINEX (https://api.apinex.bond/v1, gratis,
# 6 model free/). Mau penyedia lain? ubah AI_PROVIDER — atau lebih cepat:
# buka aplikasi → Pengaturan → Penyedia AI (tanpa restart/redeploy).
# 1) Isi kunci di bawah.
# 2) Jalankan:  node tools/server-uji.mjs   → http://127.0.0.1:8131/
#
# Berkas .env.local TIDAK ikut repo/zip (sudah ada di .gitignore).

AI_PROVIDER=apinex
APINEX_API_KEY=sk-apx-isi-kunci-apinex-mu

# Kalau mau kembali memakai 9Router (tunnel):
# AI_PROVIDER=9router
# AI_API_KEY=sk-isi-kunci-9router-mu
# AI_BASE_URL=https://rqacwx8.abc-tunnel.us/v1

# Model per mode (opsional — kalau kosong, aplikasi memakai model bawaan
# penyedia: Apinex → free/gpt-6-luna, free/glm-5.3-flash, …)
# AI_MODEL_FAST=free/gpt-6-luna
# AI_MODEL_THINK=free/glm-5.3-flash
# AI_MODEL_DEEP=free/deepseek-v4-pro-0813
# AI_MODEL_EXPERT=free/mimo-v2.6-pro
